# Cloudflare Pages _redirects file
# Processed by Cloudflare CDN — 301/302 redirects with zero CPU usage.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
# Format: <source> <destination> <status_code>

# sitemap.xml is now a direct static file — no redirect needed
# (sitemap.xml is a copy of sitemap_index.xml generated by scripts/generate-static-files.js)

# ── Fix: Path-based car type variants → canonical route page ─────────────────
# GSC reported 8,149 pages "Blocked due to 403" for URLs like /routes/xxx/suv
# These are old/wrong URL formats — redirect to canonical (no car type in path)
/routes/*/sedan /routes/:splat 301
/routes/*/suv /routes/:splat 301
/routes/*/tempo /routes/:splat 301
/routes/*/luxury /routes/:splat 301
/routes/*/innova /routes/:splat 301
/routes/*/crysta /routes/:splat 301
/routes/*/dzire /routes/:splat 301
/routes/*/ertiga /routes/:splat 301
/routes/*/traveller /routes/:splat 301


/route/* /routes/:splat 301
/service/* /services/:splat 301

# ── Duplicate page consolidation — Salt Lake & New Town ──────────────────────
/west-bengal/salt-lake-kolkata /kolkata/salt-lake 301
/west-bengal/salt-lake-kolkata/* /kolkata/salt-lake 301
/west-bengal/new-town-kolkata /kolkata/new-town 301
/west-bengal/new-town-kolkata/* /kolkata/new-town 301

# ── Service rename: Two-Way → Round Trip ─────────────────────────────────────
/services/two-way /services/round-trip 301
/:state/:city/two-way /:state/:city/round-trip 301

# ── Delhi-NCR, Uttarakhand, MP — no content, redirect to home ────────────────
/delhi-ncr / 301
/delhi-ncr/* / 301
/uttarakhand / 301
/uttarakhand/* / 301
/madhya-pradesh / 301
/madhya-pradesh/* / 301

# ── Trailing slash canonicalization — prevents duplicate content issues ───────
# Google treats /routes/kolkata-to-ranchi and /routes/kolkata-to-ranchi/ as
# different URLs. Cloudflare Pages may serve both. This forces all trailing
# slash URLs to canonical (no-trailing-slash) form.
# NOTE: Cloudflare Pages has a 100-redirect rule limit. Use splat carefully.
/routes/*/ /routes/:splat 301
/west-bengal/*/ /west-bengal/:splat 301
/jharkhand/*/ /jharkhand/:splat 301
/odisha/*/ /odisha/:splat 301
/bihar/*/ /bihar/:splat 301
/services/*/ /services/:splat 301
/kolkata/*/ /kolkata/:splat 301
